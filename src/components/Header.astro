---
import config from '../config/config.json';
import menu from '../config/menu.json';
import { isCurrent, currentAttrs } from '../lib/utils';

interface Props {
  variant?: 'base' | 'light';
}

const { variant = 'base' } = Astro.props;
const { pathname } = Astro.url;

// Webflow component-variant class for the solid (light) header.
const v = variant === 'light' ? 'w-variant-74d3a867-9a6e-f988-27aa-e3584ade1df0' : null;
const current = (href: string) => isCurrent(href, pathname) && 'w--current';
---

<div data-wf--section-header--variant={variant} class:list={['nav', v]}>
  <div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class:list={['nav-wrapper', v, 'w-nav']}>
    <div class="nav-container w-container">
      <a href="/" {...currentAttrs('/', pathname)} class:list={['nav-logo-block', 'w-nav-brand', current('/')]}>
        <div class="nav-brand"><img src={config.site.logo_light} loading="lazy" alt={config.site.logo_alt} class:list={['nav-logo', 'is-white', v]} /><img src={config.site.logo_dark} loading="lazy" alt={config.site.logo_alt} class:list={['nav-logo', 'is-dark', v]} /></div>
      </a>
      <nav role="navigation" class:list={['nav-menu-wrap', v, 'w-nav-menu']}>
        <div class="nav-menu">
          {menu.main.map((link) => (
            <a href={link.url} {...currentAttrs(link.url, pathname)} class:list={['nav-link', v, current(link.url)]}>{link.name}</a>
          ))}
          <div data-hover="false" data-delay="0" class="nav-mega w-dropdown">
            <div class:list={['nav-dropdown', 'is-toggle', v, 'w-dropdown-toggle']}>
              <div class:list={['dropdown-link', v]}>{menu.mega.label}</div>
              <div class="nav-dropdown-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M13.5 6.74998C13.5 6.74998 10.1858 11.2499 9 11.2499C7.8141 11.2499 4.5 6.74994 4.5 6.74994" stroke="currentColor" stroke-width="1.125" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
            </div>
            <nav class:list={['nav-mega-block', v, 'w-dropdown-list']}>
              <div class="nav-mega-list">
                <div class="nav-mega-grid">
                  {menu.mega.columns.map((column) => (
                    <div class="nav-mega-column">
                      <div class="section-subtitle-block is-nav-mega">{column.title}</div>
                      <div class="nav-mega-links">
                        {column.links.map((link) => (
                          <a href={link.url} {...currentAttrs(link.url, pathname)} class:list={['nav-link', v, 'is-mega', current(link.url)]}>{link.name}</a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </nav>
          </div>
        </div>
        <div class:list={['nav-button-block', v, 'is-dark']}>
          <a data-wf--secondary-button--variant="small" href={menu.cta.url} class="secondary-button w-variant-b970d769-791e-7ec0-73ad-70549a2fc272">{menu.cta.name}</a>
        </div>
        <div class:list={['nav-button-block', v, 'is-light']}>
          <a data-wf--primary-button--variant="v1" href={menu.cta.url} class="btn btn-sm btn-brand">{menu.cta.name}</a>
        </div>
      </nav>
      <div class:list={['nav-toggle', v, 'w-nav-button']}>
        <div class="nav-toggle-icon w-icon-nav-menu"></div>
      </div>
    </div>
  </div>
</div>
