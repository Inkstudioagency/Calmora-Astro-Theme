---
import { getClasses, classUrl, WEEK_DAYS } from '../../../lib/content';

// Minutes since midnight of the start time in e.g. `6:00 PM — 7:00 PM`.
const startMinutes = (time: string) => {
  const match = time.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
  if (!match) return Number.MAX_SAFE_INTEGER;
  const hours = (Number(match[1]) % 12) + (match[3].toUpperCase() === 'PM' ? 12 : 0);
  return hours * 60 + Number(match[2]);
};

const classes = await getClasses();
const week = WEEK_DAYS.map((day) => ({
  day,
  classes: classes
    .filter((entry) => entry.data.primaryDay === day)
    .sort((a, b) => startMinutes(a.data.primaryTime) - startMinutes(b.data.primaryTime)),
}));
---

<section class="section_class-schedule">
  <div class="section-gap is-page-top">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="page-header-wrapper mobile-center">
        <h1 hero-title="" class="page-header-title">Class <span class="page-header-title-accent">Schedule</span></h1>
        <div load-anim-2="" class="schedule-table-block">
          <div class="schedule-table-body">
            <div class="schedule-table-row is-week">
              {week.map(({ day, classes }, index) => (
                <div class:list={['schedule-table-cell', 'is-week', index === 0 && 'is-first']}>
                  <div class="schedule-table-label is-week">{day}</div>
                  <div class="schedule-collection-block w-dyn-list">
                    <div role="list" class="schedule-collection-list w-dyn-items">
                      {classes.map((entry) => (
                        <div role="listitem" class="schedule-collection-item w-dyn-item">
                          <a href={classUrl(entry)} class="schedule-table-class-block is-week w-inline-block">
                            <div class="schedule-table-class-badge">{entry.data.level}</div>
                            <div class="schedule-table-class-name is-week">{entry.data.title}</div>
                            <div class="schedule-table-class-rule"></div>
                            <div class="schedule-table-value is-week">{entry.data.primaryTime}</div>
                            <div class="class-card-tag is-teacher">
                              <div class="class-card-avatar-block is-small"><img src={entry.data.teacherAvatar} loading="lazy" alt={entry.data.teacherName} class="class-card-avatar" /></div>
                              <div>{entry.data.teacherName}</div>
                            </div>
                          </a>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
