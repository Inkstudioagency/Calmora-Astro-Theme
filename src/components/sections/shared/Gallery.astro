---
interface Props {
  /** Tinted by default; use `bg-white` on a white section. */
  variant?: 'base' | 'bg-white';
}

const { variant = 'base' } = Astro.props;
// Webflow component-variant class for the white version.
const v = variant === 'bg-white' ? 'w-variant-0c94badc-c27f-ebc0-c6c7-d4dae96dab26' : null;
---

<section data-wf--section-gallery--variant={variant} class:list={['section_gallery', v]}>
  <div class="section-gap">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="gallery-wrapper">
        <div class="section-heading-block is-center">
          <div layer-view-1="" class="section-subtitle-block text-size-xsmall text-color-brand text-weight-medium">Gallery</div>
          <h2 section-title="" class="section-title-block text-align-center">See What Everyday Joy <em>Looks Like</em></h2>
        </div>
        <div class="gallery-content-block">
          <div data-delay="4000" data-animation="slide" class="gallery-item-slider w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
            <div class="gallery-slider-mask w-slider-mask">
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/gallery-photo-img-1.webp" alt="Students kneeling on the studio floor rolling up their yoga mats after class" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Nurturing Mentors</div>
                  </div>
                </div>
              </div>
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/02-·-Hero.webp" alt="Woman with short brown hair resting with her eyes closed in soft studio light" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Empathetic Instructors</div>
                  </div>
                </div>
              </div>
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/about__about-hero-bg.webp" alt="Woman wearing headphones with her eyes closed during a guided relaxation" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Guiding Coaches</div>
                  </div>
                </div>
              </div>
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/gallery-photo-img-3-1.webp" alt="Woman in a white top and shorts stretching forward on the studio floor" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Inspirational Educators</div>
                  </div>
                </div>
              </div>
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/service-media-img-1-2.webp" alt="Woman in black sportswear meditating with her eyes closed in warm light" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Encouraging Leaders</div>
                  </div>
                </div>
              </div>
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/gallery-photo-img-1.webp" alt="Students kneeling on the studio floor rolling up their yoga mats after class" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Nurturing Mentors</div>
                  </div>
                </div>
              </div>
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/02-·-Hero.webp" alt="Woman with short brown hair resting with her eyes closed in soft studio light" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Empathetic Instructors</div>
                  </div>
                </div>
              </div>
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/about__about-hero-bg.webp" alt="Woman wearing headphones with her eyes closed during a guided relaxation" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Guiding Coaches</div>
                  </div>
                </div>
              </div>
              <div class="gallery-slide-block w-slide">
                <div class="gallery-item-block">
                  <div class:list={['gallery-item-card-block', v]}>
                    <div class:list={['gallery-item-image-block', v]}><img loading="lazy" src="/images/gallery-photo-img-3-1.webp" alt="Woman in a white top and shorts stretching forward on the studio floor" class="gallery-item-image"></div>
                    <div class="gallery-item-title">Inspirational Educators</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="gallery-slider-arrow-prev w-slider-arrow-left">
              <div class="team-slider-arrow-icon w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.5 12.002L19 12.002" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M10.9999 18.002C10.9999 18.002 5.00001 13.583 5 12.0019C4.99999 10.4208 11 6.00196 11 6.00196" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
            </div>
            <div class="gallery-slider-arrow-next w-slider-arrow-right">
              <div class="team-slider-arrow-icon w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18.5 11.998L5 11.998" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M13.0001 5.998C13.0001 5.998 19 10.417 19 11.9981C19 13.5792 13 17.998 13 17.998" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
            </div>
            <div class="display-none w-slider-nav w-round w-num"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
