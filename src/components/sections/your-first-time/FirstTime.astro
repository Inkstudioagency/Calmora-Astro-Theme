<section class="section_first-time">
  <div class="section-gap is-page-top">
    <div class="w-layout-blockcontainer container-main w-container">
      <div class="first-time-wrapper">
        <div class="section-header-block">
          <h1 hero-title="" class="section-header-title heading-style-1 text-color-heading">Your first <em class="section-title-italic">time here</em></h1>
          <p load-anim-2="" class="section-header-description max-width-30">Nervous? Everyone is, the first time. Here is exactly what will happen — so the only thing left to do is show up.</p>
        </div>
        <div class="step-list-block">
          <div load-anim-3="" class="step-block">
            <div class="step-media-block">
              <div class="step-image-block"><img src="/images/your-first-time__step-image-1.webp" alt="A first-time student checking in at the studio front desk" loading="lazy" class="step-image"></div>
              <div class="step-badge">
                <div class="step-number">01</div>
              </div>
            </div>
            <div class="step-text-block">
              <h2 class="card-title">Arrive 15 minutes early</h2>
              <p class="step-text">Time to check in, change, and take a breath before class begins.</p>
            </div>
          </div>
          <div load-anim-4="" class="step-block">
            <div class="step-media-block">
              <div class="step-image-block"><img src="/images/your-first-time__step-image-2.webp" alt="A teacher talking with a student before class" loading="lazy" class="step-image"></div>
              <div class="step-badge">
                <div class="step-number">02</div>
              </div>
            </div>
            <div class="step-text-block">
              <h3 class="card-title">Tell us about you</h3>
              <p class="step-text">Your teacher will ask about injuries and goals before you start.</p>
            </div>
          </div>
          <div load-anim-5="" class="step-block">
            <div class="step-media-block">
              <div class="step-image-block"><img src="/images/your-first-time__step-image-3.webp" alt="A student stretching in everyday clothes" loading="lazy" class="step-image"></div>
              <div class="step-badge">
                <div class="step-number">03</div>
              </div>
            </div>
            <div class="step-text-block">
              <h3 class="card-title">Come as you are</h3>
              <p class="step-text">Wear anything you can move in. Mats and props are free to borrow.</p>
            </div>
          </div>
          <div load-anim-6="" class="step-block">
            <div class="step-media-block">
              <div class="step-image-block"><img src="/images/your-first-time__step-image-4.webp" alt="A student resting in child&#x27;s pose on a mat" loading="lazy" class="step-image"></div>
              <div class="step-badge">
                <div class="step-number">04</div>
              </div>
            </div>
            <div class="step-text-block">
              <h3 class="card-title">Rest is allowed</h3>
              <p class="step-text">Child&#x27;s pose is an option in every class, at any moment.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
